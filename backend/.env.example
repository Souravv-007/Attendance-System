PORT=5000
NODE_ENV=development
# Local: mongodb://127.0.0.1:27017/employee-attendance
# Production: MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/employee-attendance
JWT_SECRET=replace_with_a_long_random_production_secret
# Comma-separated browser origins allowed in production. Localhost is allowed automatically.
CORS_ORIGIN=https://your-frontend.example.com
FRONTEND_URL=http://localhost:5500
# Configure all SMTP variables to enable production email delivery.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace_with_smtp_username
EMAIL_PASSWORD=replace_with_smtp_password
EMAIL_FROM=no-reply@example.com
